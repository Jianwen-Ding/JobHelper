{
  "manifest_version": 3,
  "name": "JobHelper",
  "version": "0.1.0",
  "description": "Spots job postings, offers a resume tailored from your ResumeM-M store, and fills the form from what you already wrote down.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "JobHelper"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/card.js",
        "src/content/ask.js",
        "src/shared/sites.js",
        "src/content/autofill.js",
        "src/shared/trail.js",
        "src/shared/sending.js",
        "src/content/pdfview.js",
        "vendor/pdf.min.mjs",
        "vendor/pdf.worker.min.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
